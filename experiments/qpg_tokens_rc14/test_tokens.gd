extends SceneTree
var clicked = -1
func _initialize() -> void:
    call_deferred("run_checks")
func run_checks() -> void:
    var normal = load("res://Scenes/MenuPrincipal/Campagne/GamePlay/Plateau/Pile/Jeton/jeton.tscn").instantiate()
    var token = load("res://Scenes/MenuPrincipal/Campagne/GamePlay/QuiPerdGagne/Jetons/jeton_qpg.tscn").instantiate()
    root.add_child(normal)
    root.add_child(token)
    for index in range(10):
        normal.choisir_jeton(index)
        token.choisir_jeton(index)
        assert(token.indice_jeton == normal.indice_jeton and token.nom == normal.nom)
        assert(token.couleur() == normal.couleur())
        assert(token.largeur() == 32 and token.hauteur() == 32)
        assert(token.get_node("Carre/VisuelQPG").texture != null)
        assert(token.get_node("Carre").color.a == 0 and not token.get_node("Nom").visible)
    token.hide()
    token.choisir_jeton(3)
    assert(not token.get_node("Carre/VisuelQPG").visible)
    token.show()
    assert(token.get_node("Carre/VisuelQPG").is_visible_in_tree())
    assert(not token.get_node("Nom").visible)
    token.choisir_position(Vector2(50,60))
    assert(token.get_node("Carre/VisuelQPG").global_position == Vector2(47,57))
    token.set_scale(Vector2(1.5,1.5))
    assert(token.get_node("Carre/VisuelQPG").get_global_transform().get_scale() == Vector2(1.5,1.5))
    token.choisir_reference(7)
    token.clique_gauche.connect(func(value): clicked = value)
    var event = InputEventMouseButton.new()
    event.button_index = MOUSE_BUTTON_LEFT
    event.pressed = true
    token.get_node("Carre").gui_input.emit(event)
    assert(clicked == 7 and token.get_node("Carre/VisuelQPG").mouse_filter == Control.MOUSE_FILTER_IGNORE)
    for index in [10,25,32]:
        token.choisir_jeton(index)
        assert(token.get_node("Carre/VisuelQPG").texture == null)
        assert(token.get_node("Nom").visible)
        assert(token.est_vide() == (index == 32))
    normal.queue_free()
    token.queue_free()
    var scene = load("res://Scenes/MenuPrincipal/Campagne/GamePlay/QuiPerdGagne/Jetons/pile_qpg.tscn")
    var a = scene.instantiate()
    var b = scene.instantiate()
    root.add_child(a)
    root.add_child(b)
    a.choisir_reference(0)
    b.choisir_reference(1)
    assert(a.ajouter_les_jetons([0,1,1]))
    assert(b.ajouter_les_jetons([0,32,32]))
    assert(a.liste_jetons[0].position().y - a.liste_jetons[1].position().y == 34)
    assert(a.combien_de_jetons_identiques_au_sommet() == 2)
    assert(not b.accepte_jeton(1,2))
    assert(a.retirer_le_dernier_jeton())
    assert(a.liste_jetons[2].est_vide())
    assert(a.ajouter_le_jeton_dans_le_vide(1))
    assert(a.liste_jetons[2].get_node("Carre/VisuelQPG").texture != null)
    a.queue_free()
    b.queue_free()
    print("PASS: A-J identité/couleur métier intactes, textures, 32px, hide/show, position, scale, clic, vide, K/Z, piles et mises à jour")
    await process_frame
    quit(0)
